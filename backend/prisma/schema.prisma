generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id        String   @id @default(cuid())
  name      String   
  manager   String?  
  city      String   @default("") 
  active    Boolean  @default(true)
  remark    String   @default(dbgenerated("('')")) 
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique 
  passwordHash String
  name         String     
  role         String     
  teamId       String?
  team         Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  storeId      String?
  store        Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]    @relation("SalesOrders")
  logs         AuditLog[]
}

model Store {
  id        String     @id @default(cuid())
  code      String     @unique 
  name      String     
  city      String     @default("") 
  type      String     @default("partner") 
  status    String     @default("active") 
  rating    String     @default("A") 
  address   String     @default("") 
  contact   String     @default("") 
  phone     String     @default("") 
  agreement String     @default("pending") 
  payee     Json
  users     User[]
  orders    Order[]
  logs      AuditLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Customer {
  id                String   @id @default(cuid())
  name              String   
  idType            String   @default("CCCD") 
  idNo              String   
  phone             String   
  birthDate         String   @default("") 
  gender            String   @default("") 
  address           String   
  currentAddress    String   @default("") 
  workCompany       String   @default("") 
  workPhone         String   @default("") 
  emergencyName     String   
  emergencyRelation String   
  emergencyPhone    String   
  secondName        String   @default("") 
  secondPhone       String   @default("") 
  order             Order?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([idNo])
  @@index([phone])
}

model Order {
  id            String           @id @default(cuid())
  orderNo       String           @unique 
  status        String           @default("draft") 
  customerId    String           @unique
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store            @relation(fields: [storeId], references: [id])
  salesId       String?
  sales         User?            @relation("SalesOrders", fields: [salesId], references: [id], onDelete: SetNull)
  salesName     String           
  source        String           @default("sales") 
  urgent        Boolean          @default(false)
  docs          Json
  device        Json
  checks        Json?
  payee         Json
  price         BigInt
  downPayment   BigInt           @default(0)
  principal     BigInt
  periods       Int
  rateBps       Int              @default(0)
  perPeriod     BigInt
  firstDueDate  DateTime         
  rejectReason  String           @default(dbgenerated("('')")) 
  firstReview   Json?
  finalReview   Json?
  financeReview Json?
  payoutAt      DateTime?
  payoutRef     String?          
  payoutBy      String?          
  submittedAt   DateTime?
  closedAt      DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  bills         Bill[]
  payments      PaymentRequest[]
  esignAttempts EsignAttempt[]
  mdm           MdmRecord?
  logs          AuditLog[]

  @@index([status, createdAt])
  @@index([storeId, status])
  @@index([salesId, status])
}

model MdmRecord {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serial      String    
  imei        String    
  bound       Boolean   @default(true)
  provider    String    @default("zhunfu_manual") 
  boundAt     DateTime  @default(now())
  boundBy     String    
  releasedAt  DateTime?
  releasedBy  String?   
  releaseNote String?   
  updatedAt   DateTime  @updatedAt
}

model Bill {
  id         String           @id @default(cuid())
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  period     Int
  dueDate    DateTime         
  amount     BigInt
  paidAmount BigInt           @default(0)
  status     String           @default("Pending") 
  paidAt     DateTime?
  channel    String?          
  txnNo      String?          
  note       String           @default(dbgenerated("('')")) 
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  payments   PaymentRequest[]

  @@unique([orderId, period])
  @@index([dueDate, status])
  @@index([status, dueDate])
}

model PaymentRequest {
  id            String    @id @default(cuid())
  requestNo     String    @unique 
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  billId        String
  bill          Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount        BigInt
  channel       String    
  status        String    @default("pending") 
  provider      String    
  externalTxnNo String?   
  isMock        Boolean   @default(false)
  paidAt        DateTime?
  expiresAt     DateTime?
  rawResponse   Json?
  failureReason String    @default(dbgenerated("('')")) 
  actorName     String    @default("系统") 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([channel, externalTxnNo])
  @@index([orderId, status])
  @@index([billId, status])
}

model EsignAttempt {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempt            Int
  provider           String    
  externalContractNo String?   
  status             String    @default("pending") 
  providerStatus     String    @default("") 
  failureReason      String    @default(dbgenerated("('')")) 
  pdfUrl             String?   
  rawCallback        Json?
  isMock             Boolean   @default(false)
  actorName          String    
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt

  @@unique([orderId, attempt])
  @@index([orderId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String   
  actorRole String   
  action    String   
  before    Json?
  after     Json?
  note      String   @default(dbgenerated("('')")) 
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([storeId, createdAt])
}
